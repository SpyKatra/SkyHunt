{
  "expo": {
    "name": "SkyHunt",
    "slug": "skyhunt",
    "version": "0.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.spykatra.skyhunt",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "SkyHunt enregistre le lieu de chaque capture pour calculer les points et empêcher la triche.",
        "NSPhotoLibraryAddUsageDescription": "SkyHunt peut enregistrer tes cartes dans tes photos quand tu les partages."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.spykatra.skyhunt",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#0B1220",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "plugins": [
      "expo-dev-client",
      [
        "react-native-vision-camera",
        {
          "cameraPermissionText": "SkyHunt utilise la caméra pour photographier les avions de ta collection.",
          "enableFrameProcessors": true,
          "enableMicrophonePermission": false,
          "enableLocation": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "SkyHunt enregistre le lieu de chaque capture pour calculer les points et empêcher la triche."
        }
      ],
      [
        "react-native-fast-tflite",
        {
          "enableCoreMLDelegate": true
        }
      ]
    ]
  }
}
