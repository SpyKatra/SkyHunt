diff --git a/node_modules/react-native-vision-camera-resizer/android/build.gradle b/node_modules/react-native-vision-camera-resizer/android/build.gradle
--- a/node_modules/react-native-vision-camera-resizer/android/build.gradle
+++ b/node_modules/react-native-vision-camera-resizer/android/build.gradle
@@ -152,3 +152,40 @@
   // Add a dependency on VisionCamera (for HybridLocationSpec)
   implementation project(":react-native-vision-camera")
 }
+
+// SkyHunt : AGP 9 ne compile plus les shaders (dossier src/main/shaders) ; sans ce fichier,
+// le resizer échoue au lancement (« Failed to open Vulkan shader asset shaders/Resizer.comp.spv »).
+// On compile donc Resizer.comp avec le glslc du NDK et on l'ajoute aux assets de la bibliothèque.
+abstract class SkyHuntCompileResizerShader extends DefaultTask {
+  @InputFile abstract RegularFileProperty getShaderSource()
+  @Input abstract Property<String> getGlslcPath()
+  @OutputDirectory abstract DirectoryProperty getOutputDir()
+
+  @TaskAction
+  void compile() {
+    def out = outputDir.get().file("shaders/Resizer.comp.spv").asFile
+    out.parentFile.mkdirs()
+    def proc = new ProcessBuilder(glslcPath.get(), "-O", "--target-env=vulkan1.0",
+        "-o", out.absolutePath, shaderSource.get().asFile.absolutePath).redirectErrorStream(true).start()
+    def log = proc.inputStream.text
+    if (proc.waitFor() != 0 || !out.exists()) {
+      throw new GradleException("glslc a échoué : " + log)
+    }
+  }
+}
+
+def skyHuntResizerShader = tasks.register("skyHuntCompileResizerShader", SkyHuntCompileResizerShader) {
+  shaderSource.set(layout.projectDirectory.file("src/main/shaders/Resizer.comp"))
+  outputDir.set(layout.buildDirectory.dir("generated/skyhunt-shaders"))
+  glslcPath.set(providers.provider {
+    def os = System.getProperty("os.name").toLowerCase()
+    def host = os.contains("win") ? "windows-x86_64" : (os.contains("mac") ? "darwin-x86_64" : "linux-x86_64")
+    new File(android.ndkDirectory, "shader-tools/${host}/glslc" + (os.contains("win") ? ".exe" : "")).absolutePath
+  })
+}
+
+androidComponents {
+  onVariants(selector().all()) { variant ->
+    variant.sources.assets?.addGeneratedSourceDirectory(skyHuntResizerShader, { it.outputDir })
+  }
+}
